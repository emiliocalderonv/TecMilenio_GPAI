# Copia este archivo como .env para cambiar la configuración
PUERTO=3000          # puerto de la interfaz web
PUERTO_API=8000      # puerto de la API (documentación en /docs)
OVARA_MODO_PRUEBA=0  # 1 = arrancar sin pesos reales (pesos aleatorios, solo para probar)
OVARA_HILOS=0        # hilos de CPU para PyTorch (0 = todos)
